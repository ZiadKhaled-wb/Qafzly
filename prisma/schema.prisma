generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------
// Enums
// ------------------------------
enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum ContentType {
  TEXT
  VIDEO
  QUIZ
  CODE
  MIXED
}

enum LessonStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentRequestStatus {
  PENDING
  VERIFIED
  ACTIVATED
  REJECTED
  EXPIRED
}

enum ForumPostStatus {
  published
  hidden
  deleted
}

enum ForumCommentStatus {
  published
  hidden
  deleted
}

// ------------------------------
// User Management
// ------------------------------
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  fullName      String
  displayName   String?
  country       String?
  language      String   @default("ar")
  learningGoal  String?
  skillLevel    SkillLevel @default(BEGINNER)
  bio           String?
  isPublic      Boolean  @default(true)
  avatarUrl     String?
  timezone      String?
  lastLoginAt   DateTime?
  privacySettings Json?
  role          Role     @default(STUDENT)
  isEmailVerified Boolean @default(false)
  isActive      Boolean  @default(true)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  enrollments   Enrollment[]
  progress      LessonProgress[]
  stats         UserStats?
  posts         ForumPost[]
  comments      ForumComment[]
  notifications Notification[] @relation("UserNotifications")
  sentNotifications   Notification[]   @relation("SenderNotifications")
  subscriptions Subscription[]
  purchases     Purchase[]
  badges        UserBadge[]
  xpLogs        XpAuditLog[]
  deviceTokens  DeviceToken[]
  socialLogins  UserSocialLogin[]
  forumVotes    ForumVote[]
  userQuests    UserQuest[]

  // Payment Request relations
  paymentRequests          PaymentRequest[]   // Requests made by this user
  activatedPaymentRequests PaymentRequest[]   @relation("ActivatedPaymentRequests") // Requests activated by this admin

  @@map("users")
}

model UserSocialLogin {
  id         String   @id @default(uuid())
  userId     String
  provider   String // google, facebook, apple
  providerId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("user_social_logins")
}

// ------------------------------
// Course Structure
// ------------------------------
model Course {
  id                String           @id @default(uuid())
  title             String
  titleEn           String?
  description       String
  descriptionEn     String?
  categoryId        String?
  difficulty        CourseDifficulty @default(BEGINNER)
  price             Decimal          @default(0)
  currency          String           @default("EGP")
  featuredImage     String?
  tags              String[]         @default([])
  prerequisites     String[]         @default([])
  estimatedDuration Int              @default(0) // minutes
  isPublished       Boolean          @default(false)
  isFeatured        Boolean          @default(false)
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  category    CourseCategory? @relation(fields: [categoryId], references: [id])
  modules     Module[]
  enrollments Enrollment[]
  posts       ForumPost[]
  purchases   Purchase[]
  paymentRequests PaymentRequest[] // Payment requests for this course

  @@map("courses")
}

model CourseCategory {
  id          String   @id @default(uuid())
  name        String
  nameEn      String?
  description String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   CourseCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children CourseCategory[] @relation("CategoryTree")
  courses  Course[]

  @@map("course_categories")
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  titleEn     String?
  description String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id            String      @id @default(uuid())
  moduleId      String
  title         String
  titleEn       String?
  content       String? // main content (Markdown/HTML)
  contentEn     String?
  contentType   ContentType @default(TEXT)
  videoUrl      String?
  videoDuration Int         @default(0) // seconds
  hasQuiz       Boolean     @default(false)
  order         Int         @default(0)
  isPreview     Boolean     @default(false)
  isPublished   Boolean     @default(false)
  estimatedTime Int         @default(0) // minutes
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  module        Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]
  quizQuestions QuizQuestion[]
  forumPosts    ForumPost[]

  @@map("lessons")
}

// ------------------------------
// Enrollment & Progress
// ------------------------------
model Enrollment {
  id         String    @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime  @default(now())
  expiresAt  DateTime?
  isActive   Boolean   @default(true)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id             String   @id @default(uuid())
  userId         String
  lessonId       String
  completed      Boolean  @default(false)
  timeSpent      Int      @default(0) // seconds
  quizScore      Int?
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ------------------------------
// Quiz
// ------------------------------
model QuizQuestion {
  id        String   @id @default(uuid())
  lessonId  String
  question  String
  options   Json // array of {id, text, isCorrect}
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

// ------------------------------
// Gamification
// ------------------------------
model UserStats {
  userId                String   @id
  xp                    Int      @default(0)
  level                 Int      @default(1)
  streak                Int      @default(0)
  longestStreak         Int      @default(0)
  totalCoursesCompleted Int      @default(0)
  totalLessonsCompleted Int      @default(0)
  lastStreakFreezeAt    DateTime?
  streakFreezeAvailable Int      @default(0)
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String
  iconUrl     String?
  criteria    Json
  createdAt   DateTime @default(now())

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

model XpAuditLog {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String
  source    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_audit_logs")
}

// Community (Forum)
model ForumCategory {
  id            String      @id @default(uuid())
  nameAr        String
  nameEn        String
  slug          String      @unique
  descriptionAr String?
  descriptionEn String?
  displayOrder  Int         @default(0)
  isActive      Boolean     @default(true)
  posts         ForumPost[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("forum_categories")
}

model ForumPost {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      ForumCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  courseId      String?
  course        Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessonId      String?
  lesson        Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  title         String
  content       String
  contentJson   Json?           @default("{}")

  upvotes       Int             @default(0)
  downvotes     Int             @default(0)
  viewCount     Int             @default(0)
  commentCount  Int             @default(0)

  isPinned      Boolean         @default(false)
  isSolved      Boolean         @default(false)
  isLocked      Boolean         @default(false)

  status        ForumPostStatus @default(published)
  flaggedCount  Int             @default(0)

  comments      ForumComment[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  @@index([userId])
  @@index([categoryId])
  @@index([courseId])
  @@index([status])
  @@map("forum_posts")
}

model ForumComment {
  id               String             @id @default(uuid())
  postId           String
  post             ForumPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentCommentId  String?
  parentComment    ForumComment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)

  content          String
  contentJson      Json?              @default("{}")

  upvotes          Int                @default(0)
  downvotes        Int                @default(0)
  isBestAnswer     Boolean            @default(false)
  isEdited         Boolean            @default(false)

  status           ForumCommentStatus @default(published)

  replies          ForumComment[]     @relation("CommentReplies")

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  @@index([postId])
  @@index([userId])
  @@index([parentCommentId])
  @@map("forum_comments")
}

model ForumVote {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String   @db.VarChar(20) // 'post' or 'comment'
  targetId   String   @db.Uuid
  voteType   Int      // 1 = upvote, -1 = downvote

  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("forum_votes")
}

// ------------------------------
// Payments (Manual MVP)
// ------------------------------
model Subscription {
  id              String    @id @default(uuid())
  userId          String
  plan            String    @default("monthly")
  status          String    @default("active") // active, cancelled, expired
  startDate       DateTime  @default(now())
  endDate         DateTime?
  paymentMethodId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Purchase {
  id            String        @id @default(uuid())
  userId        String
  courseId      String
  amount        Decimal
  currency      String        @default("EGP")
  status        PaymentStatus @default(PENDING)
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("purchases")
}

// Manual Payment Request
model PaymentRequest {
  id                String               @id @default(uuid())
  userId            String
  courseId          String
  amountCents       Int
  currency          String               @default("EGP")
  referenceCode     String               @unique
  paymentMethod     String               @default("vodafone_cash")
  status            PaymentRequestStatus @default(PENDING)
  userNotes         String?
  adminNotes        String?
  activatedByUserId String?
  activatedAt       DateTime?
  subscriptionDurationMonths Int          @default(1)
  rejectedReason    String?
  rejectedAt        DateTime?
  expiresAt         DateTime             // set in application code
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activatedBy User?   @relation("ActivatedPaymentRequests", fields: [activatedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([referenceCode])
  @@map("payment_requests")
}

// ------------------------------
// Notifications (Sprint 7)
// ------------------------------
model Notification {
  id           String   @id @default(uuid())
  userId       String
  user         User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  senderId     String?
  sender       User?    @relation("SenderNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  type         String   // achievement, course_update, reply, mention, system, payment, etc.
  title        String
  body         String
  link         String?
  iconUrl      String?
  imageUrl     String?
  metadata     Json?    @default("{}")
  isRead       Boolean  @default(false)
  isArchived   Boolean  @default(false)
  isDismissed  Boolean  @default(false)
  channelsSent String[] @default([])
  createdAt    DateTime @default(now())
  readAt       DateTime?
  dismissedAt  DateTime?

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken  String
  deviceType   String   // ios, android, web
  deviceId     String?
  deviceModel  String?
  osVersion    String?
  appVersion   String?
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, deviceToken])
  @@map("device_tokens")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  subjectAr String?
  subjectEn String?
  bodyAr    String?
  bodyEn    String?
  variables Json?    @default("{}")
  channel   String   @default("in_app") // in_app, email, push, sms
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

// ------------------------------
// Quests (Daily/Weekly/Special)
// ------------------------------
model Quest {
  id            String    @id @default(uuid())
  title         String
  titleEn       String?
  description   String?
  descriptionEn String?
  type          String    // "daily", "weekly", "special"
  xpReward      Int       @default(20)
  target        Int       @default(1)
  progress      Int       @default(0)
  startDate     DateTime  @default(now())
  endDate       DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userQuests UserQuest[]

  @@map("quests")
}

model UserQuest {
  id          String    @id @default(uuid())
  userId      String
  questId     String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@map("user_quests")
}