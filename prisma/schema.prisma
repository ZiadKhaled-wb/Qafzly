generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------
// Enums
// ------------------------------
enum Role {
  STUDENT
  PARENT
  ADMIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PathDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum ContentType {
  TEXT
  VIDEO
  QUIZ
  CODE
  MIXED
}

enum LessonStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentRequestStatus {
  PENDING
  VERIFIED
  ACTIVATED
  REJECTED
  EXPIRED
}

enum ForumPostStatus {
  published
  hidden
  deleted
}

enum ForumCommentStatus {
  published
  hidden
  deleted
}

enum SlideType {
  INFO
  QUIZ
  DRAG_DROP
  TRUE_FALSE
  FILL_BLANK
}

// ------------------------------
// User Management
// ------------------------------
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  fullName      String
  displayName   String?
  country       String?
  language      String   @default("ar")
  learningGoal  String?
  skillLevel    SkillLevel @default(BEGINNER)
  bio           String?
  isPublic      Boolean  @default(true)
  avatarUrl     String?
  timezone      String?
  lastLoginAt   DateTime?
  privacySettings Json?
  role          Role     @default(STUDENT)
  isEmailVerified Boolean @default(false)
  isActive      Boolean  @default(true)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Weekly digest state (Sprint 13)
  lastWeeklySummaryAt   DateTime?
  lastWeeklySummaryRank Int?

  parentId       String?
  parent         User?            @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children       User[]           @relation("ParentChildren")
  childSettingsAsChild  ChildSettings[] @relation("ChildSettingsChild")
  childSettingsAsParent ChildSettings[] @relation("ChildSettingsParent")

  enrollments   Enrollment[]
  progress      LessonProgress[]
  stats         UserStats?
  posts         ForumPost[]
  comments      ForumComment[]
  notifications Notification[] @relation("UserNotifications")
  sentNotifications   Notification[]   @relation("SenderNotifications")
  purchases     Purchase[]
  badges        UserBadge[]
  xpLogs        XpAuditLog[]
  deviceTokens  DeviceToken[]
  socialLogins  UserSocialLogin[]
  forumVotes    ForumVote[]
  reportsFiled     ForumReport[] @relation("ReportsFiled")
  reportsResolved  ForumReport[] @relation("ReportsResolved")
  userQuests    UserQuest[]
  userSlideProgress UserSlideProgress[]
  userQuestProgress UserQuestProgress[]
  userBossBattleProgress UserBossBattleProgress[]

  paymentRequests          PaymentRequest[]
  activatedPaymentRequests PaymentRequest[]   @relation("ActivatedPaymentRequests")

  certificates Certificate[]
  @@map("users")
}

model ChildSettings {
  id                    String   @id @default(uuid())
  childId               String
  parentId              String
  lockOverrideEnabled   Boolean  @default(false)
  customLockDurationHours Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  child   User @relation("ChildSettingsChild", fields: [childId], references: [id], onDelete: Cascade)
  parent  User @relation("ChildSettingsParent", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@map("child_settings")
}

model UserSocialLogin {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("user_social_logins")
}

// ------------------------------
// Path Structure
// ------------------------------
model Path {
  id                String           @id @default(uuid())
  title             String
  titleEn           String?
  description       String
  descriptionEn     String?
  categoryId        String?
  difficulty        PathDifficulty   @default(BEGINNER)
  price             Decimal          @default(0)
  currency          String           @default("EGP")
  featuredImage     String?
  tags              String[]         @default([])
  prerequisites     String[]         @default([])
  estimatedDuration Int              @default(0)
  isPublished       Boolean          @default(false)
  isFeatured        Boolean          @default(false)
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  search_vector_ar Unsupported("tsvector")?
  search_vector_en Unsupported("tsvector")?
  
  category    CourseCategory? @relation(fields: [categoryId], references: [id])
  modules     Module[]
  enrollments Enrollment[]
  posts       ForumPost[]
  purchases   Purchase[]
  paymentRequests PaymentRequest[]

  certificates Certificate[]

  @@map("paths")
}

model CourseCategory {
  id          String   @id @default(uuid())
  name        String
  nameEn      String?
  description String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   CourseCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children CourseCategory[] @relation("CategoryTree")
  paths    Path[]

  @@map("course_categories")
}

model Module {
  id          String   @id @default(uuid())
  pathId      String
  title       String
  titleEn     String?
  description String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  path    Path     @relation(fields: [pathId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  bossBattles BossBattle[]

  @@map("modules")
}

model Lesson {
  id            String      @id @default(uuid())
  moduleId      String
  title         String
  titleEn       String?
  content       String?
  contentEn     String?
  contentType   ContentType @default(TEXT)
  videoUrl      String?
  videoDuration Int         @default(0)
  hasQuiz       Boolean     @default(false)
  order         Int         @default(0)
  isPreview     Boolean     @default(false)
  isPublished   Boolean     @default(false)
  estimatedTime Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  overviewVideoUrl      String?
  pdfUrl                String?
  explanatoryVideoUrl   String?
  slidesJson            Json?
  challengeDescription  String?
  challengeType         String   @default("quiz")
  challengeData         Json?
  lockDurationHours     Int      @default(12)
  completionXpAward     Int      @default(10)   // ← NEW: XP for finishing the lesson

  // NEW: Recharge fields
  rechargeMessageAr   String?
  rechargeMessageEn   String?
  rechargeXpBoost     Boolean   @default(true)
  rechargeBoostMultiplier Int   @default(2)
  rechargeBoostWindowHours Int  @default(24)

  // NEW: Warm-up
  warmUpJson          Json?

  // NEW: Mini-Quest
  miniQuestJson       Json?

  module        Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]
  quizQuestions QuizQuestion[]
  forumPosts    ForumPost[]
  slides        Slide[]
  questCheckpoints QuestCheckpoint[]
  userSlideProgress UserSlideProgress[]
  userQuestProgress UserQuestProgress[]

  @@map("lessons")
}

model Slide {
  id            String   @id @default(uuid())
  lessonId      String
  slideType     SlideType @default(INFO)
  titleAr       String?
  titleEn       String?
  bodyAr        String?
  bodyEn        String?
  questionAr    String?
  questionEn    String?
  optionsJson   Json?
  correctIndex  Int?
  explanationAr String?
  explanationEn String?
  instructionAr String?
  instructionEn String?
  itemsJson     Json?
  statementAr   String?
  statementEn   String?
  correctAnswer Boolean?
  sentenceAr    String?
  sentenceEn    String?
  acceptedAnswersJson Json?
  order         Int
  xpAward       Int      @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userProgress  UserSlideProgress[]

  @@index([lessonId, order])
  @@map("slides")
}

model QuestCheckpoint {
  id            String   @id @default(uuid())
  lessonId      String
  titleAr       String
  titleEn       String?
  taskAr        String
  taskEn        String?
  hintAr        String?
  hintEn        String?
  xpAward       Int      @default(15)
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userProgress  UserQuestProgress[]

  @@index([lessonId, order])
  @@map("quest_checkpoints")
}

model BossBattle {
  id              String   @id @default(uuid())
  moduleId        String
  titleAr         String
  titleEn         String?
  narrativeAr     String
  narrativeEn     String?
  monsterNameAr   String
  monsterNameEn   String?
  victoryBonusPerfect Int @default(50)
  victoryBonusGood    Int @default(30)
  victoryBonusFair    Int @default(15)
  victoryBonusRetry   Int @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions       BossBattleQuestion[]
  userProgress    UserBossBattleProgress[]

  @@map("boss_battles")
}

model BossBattleQuestion {
  id              String   @id @default(uuid())
  bossBattleId    String
  questionAr      String
  questionEn      String?
  optionsAr       Json
  optionsEn       Json?
  correctIndex    Int
  explanationAr   String?
  explanationEn   String?
  xpAward         Int      @default(10)
  order           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bossBattle      BossBattle @relation(fields: [bossBattleId], references: [id], onDelete: Cascade)

  @@index([bossBattleId, order])
  @@map("boss_battle_questions")
}

model UserSlideProgress {
  id              String   @id @default(uuid())
  userId          String
  lessonId        String
  slideId         String
  completed       Boolean  @default(false)
  completedAt     DateTime?
  xpEarned        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  slide           Slide    @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([userId, slideId])
  @@index([userId, lessonId])
  @@map("user_slide_progress")
}

model UserQuestProgress {
  id              String   @id @default(uuid())
  userId          String
  lessonId        String
  checkpointId    String
  completed       Boolean  @default(false)
  completedAt     DateTime?
  xpEarned        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  checkpoint      QuestCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@unique([userId, checkpointId])
  @@index([userId, lessonId])
  @@map("user_quest_progress")
}

model UserBossBattleProgress {
  id              String   @id @default(uuid())
  userId          String
  bossBattleId    String
  score           Int      @default(0)
  totalQuestions  Int
  xpEarned        Int      @default(0)
  victoryLevel    String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bossBattle      BossBattle @relation(fields: [bossBattleId], references: [id], onDelete: Cascade)

  @@unique([userId, bossBattleId])
  @@map("user_boss_battle_progress")
}

// ------------------------------
// Enrollment & Progress
// ------------------------------
model Enrollment {
  id         String    @id @default(uuid())
  userId     String
  pathId     String
  enrolledAt DateTime  @default(now())
  expiresAt  DateTime?
  isActive   Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  path Path @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId])
  @@map("enrollments")
}

model LessonProgress {
  id             String   @id @default(uuid())
  userId         String
  lessonId       String
  completed      Boolean  @default(false)
  completedAt    DateTime?
  warmUpCompletedAt DateTime?   // ← NEW: null = warm-up not yet done
  timeSpent      Int      @default(0)
  quizScore      Int?
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ------------------------------
// Quiz
// ------------------------------
model QuizQuestion {
  id        String   @id @default(uuid())
  lessonId  String
  question  String
  options   Json
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

// ------------------------------
// Gamification
// ------------------------------
model UserStats {
  userId                String   @id
  xp                    Int      @default(0)
  level                 Int      @default(1)
  streak                Int      @default(0)
  longestStreak         Int      @default(0)
  totalPathsCompleted   Int      @default(0)
  totalLessonsCompleted Int      @default(0)
  lastStreakFreezeAt    DateTime?
  streakFreezeAvailable Int      @default(0)
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  nameEn String?
  description String
  iconUrl     String?
  criteria    Json
  createdAt   DateTime @default(now())

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

model XpAuditLog {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String
  source    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_audit_logs")
}

// Community (Forum)
model ForumCategory {
  id            String      @id @default(uuid())
  nameAr        String
  nameEn        String
  slug          String      @unique
  descriptionAr String?
  descriptionEn String?
  displayOrder  Int         @default(0)
  isActive      Boolean     @default(true)
  posts         ForumPost[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("forum_categories")
}

model ForumPost {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      ForumCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  pathId        String?
  path          Path?           @relation(fields: [pathId], references: [id], onDelete: SetNull)
  lessonId      String?
  lesson        Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  title         String
  content       String
  contentJson   Json?           @default("{}")

  upvotes       Int             @default(0)
  downvotes     Int             @default(0)
  viewCount     Int             @default(0)
  commentCount  Int             @default(0)

  isPinned      Boolean         @default(false)
  isSolved      Boolean         @default(false)
  isLocked      Boolean         @default(false)

  status        ForumPostStatus @default(published)
  flaggedCount  Int             @default(0)

  comments      ForumComment[]
  reports       ForumReport[]
  search_vector_ar Unsupported("tsvector")?
  search_vector_en Unsupported("tsvector")?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  @@index([userId])
  @@index([categoryId])
  @@index([pathId])
  @@index([status])
  @@map("forum_posts")
}

model ForumComment {
  id               String             @id @default(uuid())
  postId           String
  post             ForumPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentCommentId  String?
  parentComment    ForumComment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)

  content          String
  contentJson      Json?              @default("{}")

  upvotes          Int                @default(0)
  downvotes        Int                @default(0)
  isBestAnswer     Boolean            @default(false)
  isEdited         Boolean            @default(false)

  status           ForumCommentStatus @default(published)

  replies          ForumComment[]     @relation("CommentReplies")
  reports       ForumReport[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  @@index([postId])
  @@index([userId])
  @@index([parentCommentId])
  @@map("forum_comments")
}

model ForumVote {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String   @db.VarChar(20)
  targetId   String   @db.Uuid
  voteType   Int

  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("forum_votes")
}

// ------------------------------
// Payments (Manual MVP)
// ------------------------------

model Purchase {
  id            String        @id @default(uuid())
  userId        String
  pathId        String
  amount        Decimal
  currency      String        @default("EGP")
  status        PaymentStatus @default(PENDING)
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  path Path @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@map("purchases")
}

model PaymentRequest {
  id                String               @id @default(uuid())
  userId            String
  pathId            String
  amountCents       Int
  currency          String               @default("EGP")
  referenceCode     String               @unique
  paymentMethod     String               @default("vodafone_cash")
  status            PaymentRequestStatus @default(PENDING)
  userNotes         String?
  adminNotes        String?
  activatedByUserId String?
  activatedAt       DateTime?
  subscriptionDurationMonths Int          @default(1)
  rejectedReason    String?
  rejectedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  path        Path    @relation(fields: [pathId], references: [id], onDelete: Cascade)
  activatedBy User?   @relation("ActivatedPaymentRequests", fields: [activatedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([pathId])
  @@index([status])
  @@index([referenceCode])
  @@map("payment_requests")
}

// ------------------------------
// Notifications
// ------------------------------
model Notification {
  id           String   @id @default(uuid())
  userId       String
  user         User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  senderId     String?
  sender       User?    @relation("SenderNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  type         String
  title        String
  body         String
  link         String?
  iconUrl      String?
  imageUrl     String?
  metadata     Json?    @default("{}")
  isRead       Boolean  @default(false)
  isArchived   Boolean  @default(false)
  isDismissed  Boolean  @default(false)
  channelsSent String[] @default([])
  createdAt    DateTime @default(now())
  readAt       DateTime?
  dismissedAt  DateTime?

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken  String
  deviceType   String
  deviceId     String?
  deviceModel  String?
  osVersion    String?
  appVersion   String?
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, deviceToken])
  @@map("device_tokens")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  subjectAr String?
  subjectEn String?
  bodyAr    String?
  bodyEn    String?
  variables Json?    @default("{}")
  channel   String   @default("in_app")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

// ------------------------------
// Quests
// ------------------------------
model Quest {
  id            String    @id @default(uuid())
  title         String
  titleEn       String?
  description   String?
  descriptionEn String?
  type          String
  xpReward      Int       @default(20)
  target        Int       @default(1)
  progress      Int       @default(0)
  startDate     DateTime  @default(now())
  endDate       DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userQuests UserQuest[]

  @@map("quests")
}

model UserQuest {
  id          String    @id @default(uuid())
  userId      String
  questId     String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@map("user_quests")
}

// ------------------------------
// Certificates
// ------------------------------
model Certificate {
  id              String    @id @default(uuid())
  userId          String
  pathId          String
  certificateCode String    @unique
  issuedAt        DateTime  @default(now())
  pdfPath         String?
  metadata        Json
  revokedAt       DateTime?
  revokedReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  path Path @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId])
  @@index([certificateCode])
  @@index([userId])
  @@map("certificates")
}

// ------------------------------
// Forum Reports
// ------------------------------
model ForumReport {
  id                String    @id @default(uuid())
  postId            String?
  commentId         String?
  reporterId        String
  reason            String    // spam | harassment | inappropriate | misinformation | off-topic | other
  details           String?
  status            String    @default("pending") // pending | resolved | dismissed
  resolvedAt        DateTime?
  resolvedByUserId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  post            ForumPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment         ForumComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter        User          @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy      User?         @relation("ReportsResolved", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([postId])
  @@index([commentId])
  @@index([reporterId])
  @@map("forum_reports")
}